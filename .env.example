# VK API
# Токен сообщества VK. Никогда не публикуйте реальный токен в Git.
VK_TOKEN=

# ID сообщества VK без знака минус.
VK_GROUP_ID=

# Версия VK API.
VK_API_VERSION=5.199

# XP
XP_PER_MESSAGE=1
XP_PER_LEVEL=200

# Администраторы через запятую.
# Пример: 123456789,987654321
ADMIN_IDS=

# Максимальная длина RP-текста.
MAX_RP_TEXT=300
